# 复制本文件为 .env 后填写（.env 已被 git 忽略）
# 每行一条，不要在值中间换行；JSON 保持一行。

DASHSCOPE_API_KEY=
# 多岗位应用 ID（一行 JSON，无换行）
DASHSCOPE_APP_IDS_JSON={"java_backend":"你的Java应用ID","llm":"你的LLM应用ID"}

# 可选：不配 JSON 时单独写
# DASHSCOPE_APP_ID_JAVA_BACKEND=
# DASHSCOPE_APP_ID_LLM=

# 可选：优先用题库再生成时设为 false（默认 true 为直接走生成）
# INTERVIEW_PREFER_LLM_OVER_BANK=true
